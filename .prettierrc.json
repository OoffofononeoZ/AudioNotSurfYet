{
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": true,
    "semi": true,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "printWidth": 120,
    "objectWrap": "preserve",
    "vueIndentScriptAndStyle": false,
    "singleAttributePerLine": false,
    "bracketSameLine": true,
    "endOfLine": "auto"
}
