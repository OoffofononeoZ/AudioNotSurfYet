{
  "name": "audiosurf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:worker": "vitest run tests/worker",
    "test:analysis": "vitest run tests/analysis",
    "test:fixtures": "vitest run tests/fixtures",
    "test:m4:unit": "vitest run tests/audio/audio-engine.test.ts",
    "test:m4:integration": "vitest run tests/audio/audio-session-service.test.ts",
    "test:m5:unit": "vitest run tests/persistence/session-repository.test.ts",
    "test:m5:integration": "vitest run tests/audio/audio-session-recovery.test.ts",
    "test:docs": "node tests/docs/validate-docs.mjs",
    "test:harness": "node tests/harness/verify-failure-detection.mjs",
    "test:e2e": "playwright test --project=chrome",
    "test:e2e:m3": "playwright test tests/e2e/app-smoke.spec.ts --project=chrome",
    "test:e2e:m4": "playwright test tests/e2e/m4-playback.spec.ts --project=chrome",
    "test:e2e:m5": "playwright test tests/e2e/m5-recovery.spec.ts --project=chrome",
    "test:e2e:edge": "node tests/scripts/run-edge.mjs",
    "fixtures:generate": "node --experimental-strip-types tests/fixtures/generate-fixtures.ts",
    "fixtures:golden": "node --experimental-strip-types tests/analysis/generate-golden.ts",
    "fixtures:golden:update": "node --experimental-strip-types tests/analysis/generate-golden.ts --write",
    "eval:m3": "node tests/scripts/run-m3-eval.mjs",
    "eval:m3:provisional": "node tests/scripts/run-m3-eval.mjs --provisional",
    "eval:m4": "node tests/scripts/run-m4-eval.mjs",
    "eval:m4:provisional": "node tests/scripts/run-m4-eval.mjs --provisional",
    "eval:m5": "node tests/scripts/run-m5-eval.mjs",
    "eval:m5:provisional": "node tests/scripts/run-m5-eval.mjs --provisional"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.6",
    "@types/meyda": "^4.3.8",
    "element-plus": "^2.13.6",
    "gsap": "^3.14.2",
    "meyda": "^5.6.3",
    "mitt": "^3.0.1",
    "music-metadata": "^11.12.3",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "three": "^0.183.2",
    "vue": "^3.5.25",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.12.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.27",
    "fake-indexeddb": "^6.2.5",
    "node-web-audio-api": "^1.0.8",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.1.5"
  }
}
